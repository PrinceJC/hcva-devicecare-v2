# Server-side only. Copy to .env.local in THIS functions directory.
# Never use VITE_ prefixes for any of these values.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_API_KEY
DEVICECARE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_NEW_PROJECT_KEY
DEVICECARE_SECRET_KEY=sb_secret_REPLACE_WITH_NEW_PROJECT_SECRET_KEY
APP_ORIGIN=https://YOUR_NEW_APP.vercel.app
CRON_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ALLOW_LOCALHOST=false
